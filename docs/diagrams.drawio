        <mxCell id="nTasks" value="⏱ Cloud Tasks&#xa;inference-queue&#xa;실패 시 자동 재시도" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">

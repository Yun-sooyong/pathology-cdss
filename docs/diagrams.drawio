        <mxCell id="zSg" value="GCP  asia-southeast1 (싱가포르) — Cloud Run GPU 지원 리전" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="70" width="360" height="600" as="geometry" />
        </mxCell>
        <mxCell id="nGPU" value="segmentation-mosec  (Cloud Run)&#xa;NVIDIA L4 GPU × 1 · 4 CPU / 16Gi&#xa;min-instances 0 → 유휴 시 과금 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="110" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nSeg" value="/inference&#xa;세그멘테이션 (mosec)&#xa;&#xa;Preprocess → Inference&#xa;MC Dropout 25회&#xa;TILE_SIZE 512&#xa;&#xa;실측 7.6초 / 타일" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">

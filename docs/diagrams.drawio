          <mxGeometry y="364" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rel" value="1 : N   (1~15장)" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERoneToMany;startArrow=ERmandOne;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=12;fontStyle=1;" edge="1" parent="1" source="batch" target="job">
          <mxGeometry relative="1" as="geometry" />

          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="⑥ 원본 다운로드 / 결과 업로드" style="html=1;rounded=0;endArrow=block;startArrow=block;strokeColor=#d79b00;fontSize=10;exitX=0;exitY=0.3;entryX=0;entryY=1;" edge="1" parent="1" source="nWorker" target="nGCS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="⑦ 타일 추론 요청 (msgpack + ID 토큰)" style="html=1;rounded=0;endArrow=block;startArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=10;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" edge="1" parent="1" source="nWorker" target="nSeg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="⑧ 리포트 요청" style="html=1;rounded=0;endArrow=block;startArrow=block;strokeColor=#9673a6;dashed=1;fontSize=10;exitX=1;exitY=0.7;entryX=0.5;entryY=1;" edge="1" parent="1" source="nWorker" target="nMG">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="⑨ PATCH 결과 기록" style="html=1;rounded=0;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="nWorker" target="nDjango">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="545" />
              <mxPoint x="345" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="가중치 로드" style="html=1;rounded=0;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="nModels" target="nSeg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="archNote" value="리전 분리 이유&#xa;&#xa;• Cloud Run GPU는 서울·도쿄를 지원하지 않는다 → 아시아에서는 싱가포르가 유일&#xa;• Django·DB·큐·워커는 서울에 두고, GPU 추론만 싱가포르로 분리&#xa;• GPU는 인스턴스 생존 시간만큼 과금되므로, 다운로드·타일링·통신 같은&#xa;  GPU가 필요 없는 작업은 CPU 워커가 맡는다" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="archLegend" value="범례&#xa;&#xa;━━ 실선 : 구현·검증 완료&#xa;┅┅ 점선 : 미구현 / 예정&#xa;🟧 주황 : 저장소·큐&#xa;🟪 보라 : GPU 추론&#xa;🟥 빨강 : 미배포" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="700" width="230" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. 프론트엔드 화면 플로우" id="fe-01">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="feTitle" value="프론트엔드 화면 플로우" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f0" value="시작" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="70" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="📊 대시보드&#xa;DashboardScreen&#xa;&#xa;최근 케이스 목록&#xa;확인 필요 케이스" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="150" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="📤 업로드&#xa;UploadScreen&#xa;&#xa;이미지 1~15장 선택&#xa;모델 선택 (attention_unet_v1)&#xa;예상 소요 시간 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="170" height="115" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="① POST /api/batches&#xa;서명 URL 발급" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="310" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="② GCS 직접 PUT&#xa;(파일별 진행률 표시)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="375" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fd1" value="업로드 실패한&#xa;파일이 있나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="450" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="재시도 (1~2회)&#xa;서명 URL 유효기간 60분 내&#xa;재사용 가능" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="455" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="③ POST /batches/{id}/start&#xa;{uploaded_job_ids: 성공분만}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="575" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="⏳ 로딩 / 진행상황&#xa;LoadingScreen&#xa;&#xa;4초 간격 폴링&#xa;GET /api/result/{batch_id}&#xa;총 n장 / 완료 nn / 에러 m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="565" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fd2" value="모든 Job이&#xa;끝났나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="720" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="📋 요약&#xa;SummaryScreen&#xa;&#xa;배치 결과 리스트&#xa;케이스별 sTIL / 기권 여부" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="710" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="🔍 상세&#xa;DetailScreen&#xa;&#xa;GET /api/jobs/{job_id}&#xa;세그 결과 이미지&#xa;sTIL + 예측구간 막대&#xa;기권 뱃지 · 판독 보고서" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="700" width="190" height="125" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="⚠️ 오류&#xa;ErrorScreen&#xa;&#xa;실패한 케이스 목록&#xa;오류 리포트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="710" width="170" height="100" as="geometry" />

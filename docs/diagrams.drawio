          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe11" value="아니오 — 4초 후 재조회" style="html=1;rounded=0;endArrow=block;dashed=1;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fd2" target="f7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="760" />
              <mxPoint x="50" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fe12" value="예" style="html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="fd2" target="f8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe13" value="항목 클릭" style="html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="f8" target="f9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe14" value="에러 건 확인" style="html=1;rounded=0;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="f9" target="f10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe15" value="완료 후 대시보드로" style="html=1;rounded=0;endArrow=block;dashed=1;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="f8" target="f1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="feNote" value="업로드가 3단계인 이유&#xa;&#xa;병리 이미지는 최대 141MB인데 Cloud Run은 요청 32MB 제한이 있다.&#xa;그래서 Django는 업로드 권한(서명 URL)만 발급하고,&#xa;파일은 브라우저가 GCS로 직접 보낸다.&#xa;&#xa;부수 효과: 파일별 업로드 진행률 표시가 가능해진다." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="130" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="feNote2" value="부분 실패 처리&#xa;&#xa;15장 중 1장이 실패했다고 전체를 다시 올리는 것은&#xa;파일이 커서 부담이 크다. 그래서 성공한 job_id만&#xa;start에 전달하면, 나머지는 error로 표시되고&#xa;성공분만 추론이 진행된다.&#xa;(요약 화면의 에러 건수에 반영됨)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="430" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
